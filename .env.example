# JS Discovery - Environment Configuration

# Backend
DATABASE_URL=sqlite:///js_discovery.db
APP_ENV=development
BACKEND_PORT=3001

# REQUIRED in production: generate with `openssl rand -hex 32`
SECRET_KEY=

# Frontend
REACT_APP_API_URL=http://localhost:3001/api
NODE_ENV=development

# CORS — set to your frontend origin in production (no trailing slash)
# Example for subdomain: CORS_ORIGINS=https://jsdiscovery.example.com
# Example for public IP: CORS_ORIGINS=http://203.0.113.10:3000
# Multiple origins: CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=http://localhost:3000

# Rate limiting (adjust for public deployments)
# Scan creation limit (POST /api/scans)
RATELIMIT_SCAN_CREATE=10 per minute
# General API limit (all other endpoints)
RATELIMIT_DEFAULT=120 per minute
# Storage backend: use redis:// for multi-process/multi-host deployments
# RATELIMIT_STORAGE_URI=memory://

# Per-JS-file download size cap (bytes) — default 10 MB
# MAX_JS_DOWNLOAD_BYTES=10485760

# Gunicorn (production only)
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=300
# LOG_LEVEL=info
